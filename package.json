{
  "name": "mrk-tradex-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api:install": "cd apps/ecommerce/server && npm install",
    "api:dev": "cd apps/ecommerce/server && npm run dev",
    "api:build": "cd apps/ecommerce/server && npm run build",
    "api:prisma": "cd apps/ecommerce/server && npm run prisma",
    "api:seed": "cd apps/ecommerce/server && npm run seed",
    "api:seed:mrk-panel": "cd apps/ecommerce/server && npm run seed:mrk-panel",
    "db:up": "docker compose -f apps/ecommerce/server/docker-compose.yml up -d",
    "db:down": "docker compose -f apps/ecommerce/server/docker-compose.yml down",
    "db:migrate": "cd apps/ecommerce/server && npm run prisma -- migrate dev",
    "ecom:install": "npm --prefix apps/ecommerce/client install && npm --prefix apps/ecommerce/server install",
    "ecom:dev:client": "npm --prefix apps/ecommerce/client run dev -- -p 3001",
    "ecom:dev:server": "cd apps/ecommerce/server && npm run dev",
    "ecom:build:client": "npm --prefix apps/ecommerce/client run build",
    "ecom:build:server": "cd apps/ecommerce/server && npm run build"
  },
  "dependencies": {
    "@apollo/client": "^3.13.7",
    "@reduxjs/toolkit": "^2.6.1",
    "@stripe/stripe-js": "^7.0.0",
    "apexcharts": "^4.5.0",
    "axios": "^1.16.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.5.0",
    "graphql": "^16.10.0",
    "gsap": "^3.15.0",
    "lodash": "^4.17.21",
    "lodash.isequal": "^4.5.0",
    "lucide-react": "^0.483.0",
    "next": "15.5.18",
    "nprogress": "^0.2.0",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.1",
    "subscriptions-transport-ws": "^0.11.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9",
    "eslint-config-next": "15.2.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.5",
    "typescript": "^5.7.0"
  }
}
