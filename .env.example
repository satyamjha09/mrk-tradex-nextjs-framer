NEXT_PUBLIC_API_URL_DEV=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Keep false for live database-backed catalog. Set true only for local demos.
NEXT_PUBLIC_USE_DEMO_CATALOG=false

# Optional: make all imported ecommerce UI read from demo data instead of live API.
NEXT_PUBLIC_DEMO_MODE=false

# Gmail SMTP notifications for contact and dealership forms.
# Use a Google App Password, not the normal Gmail password.
EMAIL_USER=rajesh.mrktradex@gmail.com
EMAIL_PASS=replace-with-google-app-password
EMAIL_FROM="MRK Tradex <rajesh.mrktradex@gmail.com>"
MRK_NOTIFY_EMAIL=rajesh.mrktradex@gmail.com
