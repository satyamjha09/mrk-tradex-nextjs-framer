NEXT_PUBLIC_API_URL_DEV=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Keep this true until PostgreSQL is configured and the API has seeded data.
NEXT_PUBLIC_USE_DEMO_CATALOG=true

# Optional: make all imported ecommerce UI read from demo data instead of live API.
NEXT_PUBLIC_DEMO_MODE=true
